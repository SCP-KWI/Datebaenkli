# Datebänkli — environment
#
# Copy to .env on the server and fill in generated secrets:
#   cd /opt/apps/datebaenkli
#   cp .env.example .env
#
# Generate each secret with:
#   openssl rand -base64 32
#
# .env is gitignored and must never be committed.

# --- Postgres superuser (used by the db container itself) -------------------
POSTGRES_PASSWORD=

# --- The application's Postgres role -----------------------------------------
# Owns both databases and provisions student roles/schemas.
# Consumed by BOTH containers; must match.
# NOTE: only applied on FIRST start (initdb). Changing it later requires
#   ALTER ROLE dbk_app PASSWORD '...';  inside the db container.
DBK_APP_DB_PASSWORD=

# --- App secrets --------------------------------------------------------------
# Signs session cookies. Rotating it logs everyone out.
DBK_SESSION_SECRET=
# Encrypts stored student Postgres passwords (AES-256-GCM).
# MUST be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# WARNING: losing this makes every student DB credential unrecoverable.
DBK_ENCRYPTION_KEY=

# --- Initial admin ------------------------------------------------------------
# Created on first boot only, and only if no admin account exists yet.
# Change the password after first login, then blank this out.
DBK_BOOTSTRAP_ADMIN_USER=admin
DBK_BOOTSTRAP_ADMIN_PASSWORD=

# --- Public URL ---------------------------------------------------------------
# The address students actually type. It is not cosmetic: its scheme decides
# whether the session cookie is Secure/__Host-, and it is what the roster prints
# on credential slips, so a wrong value here reaches paper.
DBK_PUBLIC_URL=https://datebaenkli.example.com

# --- Limits (defaults are sensible; override only if needed) -----------------
DBK_STUDENT_QUOTA_MB=50
DBK_STATEMENT_TIMEOUT=15s
DBK_MAX_RESULT_ROWS=1000
# A byte ceiling on everything one script keeps, alongside the row cap. The two
# bound different things: 1000 rows of repeat('x', 100000000) is twenty cells
# and two gigabytes.
DBK_MAX_RESULT_BYTES=16777216
DBK_DEFAULT_LOCALE=de

# How long `query_log` keeps a student's SQL text, in days. One school term.
# Nothing in the app reads a row older than the current session; keeping them
# forever only put them in every backup.
DBK_QUERY_LOG_RETENTION_DAYS=120

# How long a login lasts. A school day plus slack, so nobody is dropped
# mid-lesson. Sessions in active use are extended automatically.
DBK_SESSION_TTL_HOURS=12

# The ceiling on that automatic extension, measured from when the session was
# created. Without one, a session in continuous use is renewed forever and a
# token taken off a shared classroom machine never expires. A week is far past
# any lesson, so it can only fire between them.
DBK_SESSION_ABSOLUTE_TTL_HOURS=168

# --- Proxy and cookies --------------------------------------------------------
# The existing Docker network your reverse proxy runs on. The app container
# joins it so the proxy can reach port 3000 without any host port being
# published; the database container deliberately does not. Find the name with
# `docker network ls`.
DBK_PROXY_NETWORK=proxy

# Reverse-proxy hops in front of the app. The client IP is read this many
# entries from the right of X-Forwarded-For; NOT "trust everything", or the
# per-IP login limiter can be reset with a spoofed header.
DBK_TRUST_PROXY_HOPS=1

# Marks the session cookie Secure (and uses the __Host- name prefix).
# Leave BLANK to infer it from DBK_PUBLIC_URL's scheme — which is what you want.
# Set to "false" only for the deliberately TLS-less first bring-up in HANDOFF
# §5: over plain http the browser silently discards a Secure cookie, so every
# login appears to succeed and the next request is a 401.
DBK_COOKIE_SECURE=

# --- Host paths for dumps ------------------------------------------------------
# Point these at bulk storage rather than at the fast disk holding ./pgdata.
# Dumps are write-once and read-rarely, they grow without bound until pruned,
# and keeping them off the root filesystem means they survive a rebuild of it.
# `/mnt/bulk` below is a placeholder — use whatever the mount is called on your
# host.
# DBK_BACKUP_DIR is read by compose (it mounts it into the app) and by
# db/backup.sh, which runs on the host from cron and writes the nightly dumps
# there. The script's other knobs — DBK_BACKUP_KEEP, DBK_BACKUP_ENV,
# DBK_BACKUP_MAX_AGE_HOURS — are not read from this file; they have sane
# defaults and belong in the crontab line if you ever need to change one.
# NOTE: db/backup.sh copies THIS FILE into each backup, because without
# DBK_ENCRYPTION_KEY the meta dump cannot be used (HANDOFF §4y).
DBK_BACKUP_DIR=/mnt/bulk/datebaenkli/backups
DBK_ARCHIVE_DIR=/mnt/bulk/datebaenkli/archive

# --- Account lifecycle (architecture §8b, phase 5b) --------------------------
# Idle days before a student is archived — NOLOGIN, schema untouched, one click
# back. Defaults to 365; the floor is 30, because this is the input to a job
# that takes logins away in bulk and a fat-fingered "1" would archive a school.
# It used to live in the `setting` table, seeded and read by nothing; migration
# 002 deletes that row, because a value nothing validates deciding this is worse
# than a redeploy to change it.
DBK_ARCHIVE_AFTER_DAYS=365

# When the sweep runs, local time. Default 03:40 — after db/backup.sh's 03:17 in
# the host crontab, so that night's backup holds the PRE-sweep state. Not during
# the day: a sweep can archive an account a second before its owner logs in.
DBK_ARCHIVE_SWEEP_HOUR=3
DBK_ARCHIVE_SWEEP_MINUTE=40

# Set to "false" to disarm the sweep entirely. Nothing else is scheduled: cold
# storage, the destructive half, is admin-triggered one account at a time.
DBK_ARCHIVE_SWEEP=true
